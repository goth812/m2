createTile(2, "cframe speed", false, function(v)
	CFSpeedState.enabled = v
	if v then
		if CFSpeedState.conn then CFSpeedState.conn:Disconnect() end
		CFSpeedState.conn = RunService.Stepped:Connect(function(_, dt)
			dt = math.min(dt or 0.016, 0.05)
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not (hrp and hum) then return end
			local dir = hum.MoveDirection
			local bypassMode = (CFSpeedState.mode == "bypass" or CFSpeedState.mode == "bypass legit")
			if SpeedSpoof.active then SpeedSpoof_Advance(dt) end
			if dir.Magnitude > 0.1 then
				if CFSpeedState.mode == "rage" then
					if hum.WalkSpeed ~= 0 then hum.WalkSpeed = 0 end
					local hdir = Vector3.new(dir.X, 0, dir.Z)
					if hdir.Magnitude > 0 then
						hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + hdir.Unit)
						local totalSpd = CFSpeedState.speed
						if SpeedState.enabled and SpeedState.combine then totalSpd = totalSpd + SpeedState.speed end
						if CFSpeedState.cap > 0 and totalSpd > CFSpeedState.cap then
							totalSpd = CFSpeedState.cap
						end
						hrp.AssemblyLinearVelocity = Vector3.new(hdir.Unit.X * totalSpd, hrp.AssemblyLinearVelocity.Y, hdir.Unit.Z * totalSpd)
					end
				elseif CFSpeedState.mode == "safe" then
					local spd = math.min(CFSpeedState.speed, 200)
					if hum.WalkSpeed ~= spd then hum.WalkSpeed = spd end
				elseif bypassMode then
					local spd = CFSpeedState.speed
					if SpeedState.enabled and SpeedState.combine then spd = spd + SpeedState.speed end
					spd = math.min(spd, CFSpeedState.cap)
					local jitter = 1 + (math.random() - 0.5) * 0.05
					local delta = dir.Unit * (spd * dt * jitter)
					hrp.CFrame = hrp.CFrame + delta
				else
					local spd = CFSpeedState.speed
					if SpeedState.enabled and SpeedState.combine then spd = spd + SpeedState.speed end
					local delta = dir.Unit * (spd * dt)
					hrp.CFrame = hrp.CFrame + delta
					pcall(function() Camera.CFrame = Camera.CFrame + delta end)
				end
			elseif CFSpeedState.mode == "rage" then
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
		end)
	else
		if CFSpeedState.conn then CFSpeedState.conn:Disconnect() CFSpeedState.conn = nil end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end) end
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = SpeedState.enabled and SpeedState.speed or 16 end
	end
end, {
