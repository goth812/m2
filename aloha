local function randomString(n)
	local t = {}
	for i = 1, n do t[i] = string.char(math.random(97, 122)) end
	return table.concat(t)
end

local function new(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do obj[k] = v end
	obj.Parent = parent
	return obj
end

local function getGuiParent()
	local ok, res
	if typeof(gethui) == "function" then
		ok, res = pcall(gethui)
		if ok and res then return res end
	end
	ok, res = pcall(function() return game:GetService("CoreGui") end)
	if ok and res then return res end
	return player:WaitForChild("PlayerGui")
end

local function tween(obj, dur, props)
	local tw = TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function addEdgeFade(frame, vertical)
	local g = new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.08, 0),
			NumberSequenceKeypoint.new(0.92, 0), NumberSequenceKeypoint.new(1, 1),
		}),
	}, frame)
	if vertical then g.Rotation = 90 end
end

local function loadAsset(path)
	local loaders = {}
	if typeof(getcustomasset) == "function" then table.insert(loaders, getcustomasset) end
	if typeof(getsynasset) == "function" then table.insert(loaders, getsynasset) end
	if typeof(getCustomAsset) == "function" then table.insert(loaders, getCustomAsset) end
	for _, fn in ipairs(loaders) do
		local ok, res = pcall(fn, path)
		if ok and typeof(res) == "string" then return res end
	end
	return ""
end

local function fmt(v, r)
	if not r or r == 0 then return tostring(math.floor(v + 0.5)) end
	return string.format("%." .. r .. "f", v)
end

local function toHex(c)
	return string.format("#%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

