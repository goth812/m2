RunService.RenderStepped:Connect(function(dt)
	if not (CrosshairState.enabled and crossGui) then return end
	local container = crossGui:FindFirstChild("Container")
	if not container then return end
	crossTime = crossTime + dt
	local targetX, targetY
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		targetX = Camera.ViewportSize.X / 2
		targetY = Camera.ViewportSize.Y / 2
	else
		local mp = UserInputService:GetMouseLocation()
		targetX = mp.X
		targetY = mp.Y
	end
	container.Position = UDim2.new(0, targetX, 0, targetY)
	local progress = (crossTime * CrosshairState.spin) % 1
	local slowdown = 1
	if progress >= 0.6 then
		local sp = (progress - 0.6) / 0.35
		slowdown = math.max(1 - (sp * sp * 0.7), 0.3)
	end
	crossRot = crossRot + 360 * CrosshairState.spin * dt * slowdown
	container.Rotation = crossRot
	local pulse = (math.sin(crossTime * 2.5) * 0.5 + 0.5)
	local curLen = CrosshairState.length * (0.4 + 0.8 * pulse)
	crossLines.top.Size = UDim2.new(0, 3, 0, curLen)
	crossLines.bottom.Size = UDim2.new(0, 3, 0, curLen)
	crossLines.left.Size = UDim2.new(0, curLen, 0, 3)
	crossLines.right.Size = UDim2.new(0, curLen, 0, 3)
	crossLines.bottom.Position = UDim2.new(0.5, -1.5, 1, -curLen)
	crossLines.right.Position = UDim2.new(1, -curLen, 0.5, -1.5)
	local color = CrosshairState.color
	if CrosshairState.rainbow then
		color = Color3.new(math.sin(crossTime * 0.6) * 0.5 + 0.5, math.sin(crossTime * 0.6 + 2) * 0.5 + 0.5, math.sin(crossTime * 0.6 + 4) * 0.5 + 0.5)
	end
	for _, l in pairs(crossLines) do l.BackgroundColor3 = color end
end)

