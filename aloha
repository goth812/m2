	local function doSearch(t)
		t = (t or ""):match("^%s*(.-)%s*$") or ""
		if t == "" then return end
		if S.token == "" then status = "set token" return end
		status = "resolving"
		task.spawn(function()
			if t:find("^https?://") then
				local res, err = resolveLink(t)
				status = ""
				if not res then status = tostring(err) return end
				clear2(listS)
				pushView()
				viewTitle.Visible = true
				if res.type == "user" then openUser(res.id, res.name) return end
				if res.type == "album" then
					viewTitle.Text = res.name
					local card = new("Frame", {Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = CONFIG.COLOR_TILE_ON, BorderSizePixel = 0}, listS)
					new("UICorner", {CornerRadius = UDim.new(0, 5)}, card)
					local th = new("ImageLabel", {Position = UDim2.fromOffset(5, 5), Size = UDim2.fromOffset(36, 36), BackgroundColor3 = CONFIG.COLOR_FIELD, BorderSizePixel = 0, ScaleType = Enum.ScaleType.Crop, Image = res.art ~= "" and (string.gsub(res.art, "-large", "-t500x500")) or ""}, card)
					new("UICorner", {CornerRadius = UDim.new(0, 4)}, th)
					new("TextLabel", {Position = UDim2.fromOffset(46, 6), Size = UDim2.new(1, -52, 0, 16), BackgroundTransparency = 1, Font = FONT_UI, TextSize = 12, TextColor3 = CONFIG.COLOR_TEXT_ACTIVE, Text = res.name, TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left}, card)
					new("TextLabel", {Position = UDim2.fromOffset(46, 24), Size = UDim2.new(1, -52, 0, 14), BackgroundTransparency = 1, Font = FONT_UI, TextSize = 10, TextColor3 = CONFIG.COLOR_TEXT_DIM, Text = #res.tracks .. " tracks", TextXAlignment = Enum.TextXAlignment.Left}, card)
					for _, e in ipairs(res.tracks) do trackRow(listS, e) end
				else
					viewTitle.Text = "track"
					lastResults = res.tracks
					refreshSearch()
				end
			else
				clear2(listS)
				lastResults = {}
				if S.showSongs then
					local tracks = searchTracks(t) or {}
					lastResults = tracks
					if #tracks > 0 then
						sectionHead(listS, "songs · " .. #tracks)
						for _, e in ipairs(tracks) do trackRow(listS, e) end
					end
				end
				if S.showPlaylists then
					local pls = scSearchList("playlists", t) or {}
					local shown = 0
					for _, it in ipairs(pls) do
						local out = {}
						for _, tr in ipairs(it.tracks or {}) do local e = mapTrack(tr) if e.stream then out[#out + 1] = e end end
						if #out > 0 then
							if shown == 0 then sectionHead(listS, "playlists") end
							shown = shown + 1
							albumRow(listS, {name = it.title or "playlist", art = it.artwork_url or "", tracks = out})
						end
					end
				end
				if S.showArtists then
					local users = scSearchList("users", t) or {}
					if #users > 0 then
						sectionHead(listS, "artists")
						for _, u in ipairs(users) do userRow(listS, u) end
					end
				end
				status = ""
				showOnly(viewSearch)
			end
		end)
	end
