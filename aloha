			cloneSetCF(CFrame.new(9999, 9999, 9999))
			BodyCloneDesyncHighlight.Enabled = false
		end
		if DesyncLine1 then DesyncLine1.Visible = false end
		if Camera.CameraSubject == desync_setback then
			Camera.CameraSubject = nil
		end
		return
	end
	local hrp = player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local oldCFrame = hrp.CFrame
	local desyncCFrame = oldCFrame
	if DesyncState.Enabled then
		if DesyncState.Mode == "default" then
			if DesyncState.FrozenPos then
				desyncCFrame = CFrame.new(DesyncState.FrozenPos) * oldCFrame.Rotation
			end
		elseif DesyncState.Mode == "Break Aim" then
			desyncCFrame = CFrame.new(9e9, 1, 1) * oldCFrame.Rotation
		elseif DesyncState.Mode == "Underground" then
			desyncCFrame = CFrame.new(hrp.Position + Vector3.new(0, DesyncState.UndergroundY, 0)) * oldCFrame.Rotation
		elseif DesyncState.Mode == "Void Spam" then
			desyncCFrame = math.random(1, 2) == 1 and oldCFrame or CFrame.new(math.random(10000, 50000), math.random(10000, 50000), math.random(10000, 50000)) * oldCFrame.Rotation
		elseif DesyncState.Mode == "Void" then
			desyncCFrame = (oldCFrame + Vector3.new(math.random(-444444, 444444), math.random(-444444, 444444), math.random(-44444, 44444))) * oldCFrame.Rotation
		elseif DesyncState.Mode == "Random" then
			local now = tick()
			if not DesyncState._nextRand or now >= DesyncState._nextRand then
				DesyncState._nextRand = now + DesyncState.RandomInterval
				local amount = DesyncState.RandomAmount
				DesyncState._randOffset = Vector3.new(math.random(-amount, amount), math.random(-amount / 2, amount / 2), math.random(-amount, amount))
			end
			desyncCFrame = CFrame.new(oldCFrame.Position + (DesyncState._randOffset or Vector3.zero)) * oldCFrame.Rotation
		elseif DesyncState.Mode == "orbit" or DesyncState.Mode == "orbit house" then
			local t = tick() * DesyncState.OrbitSpeed
			local oy = DesyncState.OrbitY
			if DesyncState.Mode == "orbit house" then
				oy = oy + math.sin(tick() * DesyncState.OrbitBounceSpeed) * DesyncState.OrbitBounceAmp
			end
			local offset = Vector3.new(math.cos(t) * DesyncState.OrbitRadius, oy, math.sin(t) * DesyncState.OrbitRadius)
			desyncCFrame = CFrame.new(oldCFrame.Position + offset) * oldCFrame.Rotation
		elseif DesyncState.Mode == "Safe Shoot" then
			desyncCFrame = CFrame.new(hrp.Position - Vector3.new(0, 5, 0)) * CFrame.Angles(math.random(0, 360), math.random(0, 360), math.rad(180))
		elseif DesyncState.Mode == "Custom" then
			desyncCFrame = CFrame.new(hrp.Position + Vector3.new(DesyncState.CustomX, DesyncState.CustomY, DesyncState.CustomZ)) * oldCFrame.Rotation
		end
		hrp.CFrame = desyncCFrame
		Camera.CameraSubject = desync_setback
		RunService.RenderStepped:Wait()
		desync_setback.CFrame = oldCFrame * CFrame.new(0, hrp.Size.Y / 2 + 0.5, 0)
		hrp.CFrame = oldCFrame
	end
	local visualizeCFrame = DesyncState.Enabled and desyncCFrame or hrp.CFrame
	if BodyCloneDesync then
		if DesyncState.Visualize and DesyncState.Enabled then
			cloneSetCF(visualizeCFrame)
			BodyCloneDesyncHighlight.Enabled = true
		else
			BodyCloneDesyncHighlight.Enabled = false
			cloneSetCF(CFrame.new(9999, 9999, 9999))
		end
	end
	if DesyncLine1 then
		if DesyncState.Line and DesyncState.Enabled then
			local screenRoot, onScreenRoot = Camera:WorldToViewportPoint(visualizeCFrame.Position)
			if onScreenRoot then
				DesyncLine1.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
				DesyncLine1.To = Vector2.new(screenRoot.X, screenRoot.Y)
				DesyncLine1.Visible = true
			else
				DesyncLine1.Visible = false
			end
		else
			DesyncLine1.Visible = false
		end
	end
end)

