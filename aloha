				if hdir.Magnitude > 0.1 then
					local hit = workspace:Raycast(root.Position, hdir.Unit * 2.2, mvRayParams)
					if hit and math.abs(hit.Normal.Y) < 0.3 then
						root.AssemblyLinearVelocity = Vector3.new(
							root.AssemblyLinearVelocity.X * 0.4,
							Mv.spider.val,
							root.AssemblyLinearVelocity.Z * 0.4
						)
					end
				end
			end
		end

		if Mv.strafe.on then
			if grounded and Mv.strafe.bhop and hum.MoveDirection.Magnitude > 0.1 then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
			local wish = hum.MoveDirection
			if Mv.strafe.safeSpeed and grounded and wish.Magnitude > 0.1 and Mv.bhop.cur > 16 then
				local v = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(wish.Unit.X * Mv.bhop.cur, v.Y, wish.Unit.Z * Mv.bhop.cur)
			end
			if inAir and wish.Magnitude > 0.1 then
				local wu = wish.Unit
				local cap = Mv.strafe.val
				if Mv.strafe.mode == "legit" then cap = math.min(cap, Mv.strafe.legitCap) end
				if Mv.strafe.mode ~= "cframe" then
					local v = root.AssemblyLinearVelocity
					local h = Vector3.new(v.X, 0, v.Z)
					local proj = h:Dot(wu)
					local add = math.min(cap * dt * 8, math.max(0, cap - proj))
					if add > 0 then h = h + wu * add end
					Mv.bhop.cur = h.Magnitude
					root.AssemblyLinearVelocity = Vector3.new(h.X, v.Y, h.Z)
				else
					Mv.bhop.cur = Mv.strafe.val
					root.CFrame = root.CFrame + wu * (cap * dt)
				end
			elseif wish.Magnitude < 0.1 then
				Mv.bhop.cur = 0
			end
		end

		if Mv.bhop.on then
			if grounded and Mv.bhop.autojump and hum.MoveDirection.Magnitude > 0.1 then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
			if hum.MoveDirection.Magnitude > 0.1 and (inAir or Mv.bhop.cur > 16) then
				Mv.bhop.cur = math.min(Mv.bhop.cur + 60 * dt, Mv.bhop.max)
				if hum.WalkSpeed ~= Mv.bhop.cur then hum.WalkSpeed = Mv.bhop.cur end
			elseif hum.MoveDirection.Magnitude < 0.1 then
				Mv.bhop.cur = 0
				if hum.WalkSpeed ~= 16 then hum.WalkSpeed = 16 end
			end
		end

		local onOwn = mvAirwalkPart and mvAirwalkPart.Parent ~= nil
		if grounded then
			if not onOwn then
				Mv.airwalk.lockY = root.Position.Y
			elseif root.Position.Y > Mv.airwalk.lockY + 0.6 then
				Mv.airwalk.lockY = root.Position.Y
			end
		end
		if Mv.airwalk.on and inAir then
			if not mvAirwalkPart or not mvAirwalkPart.Parent then
				mvAirwalkPart = Instance.new("Part")
				mvAirwalkPart.Name = "AlohaAirwalk"
				mvAirwalkPart.Size = Vector3.new(4, 0.5, 4)
				mvAirwalkPart.Anchored = true
				mvAirwalkPart.CanCollide = true
				mvAirwalkPart.Transparency = 1
				mvAirwalkPart.Parent = workspace
			end
			local baseY = Mv.airwalk.mode == "solid" and (Mv.airwalk.lockY or root.Position.Y) or root.Position.Y
			local drop = Mv.airwalk.mode == "solid" and 2.8 or 3.2
			mvAirwalkPart.Position = Vector3.new(root.Position.X, baseY - drop, root.Position.Z)
			if Mv.airwalk.mode == "solid" then
				local v = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
			end
		elseif mvAirwalkPart and mvAirwalkPart.Parent and not Mv.airwalk.on then
			mvAirwalkPart:Destroy()
			mvAirwalkPart = nil
		end
	end)
end
local function mvStopAll()
	if mvStepConn then mvStepConn:Disconnect() mvStepConn = nil end
	if mvAirwalkPart and mvAirwalkPart.Parent then mvAirwalkPart:Destroy() mvAirwalkPart = nil end
