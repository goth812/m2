local function ReapplyVisuals_OnCharacterSpawned(char)
	task.wait(1)
	Desync_ResetCamera() -- [v2 fix #02] camera back to humanoid after respawn
	if DesyncState.Enabled and DesyncState.Mode == "default" then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then DesyncState.FrozenPos = hrp.Position end
	end
	if HatVariables.enabled and HatVariables.style == "Classic" then Hat_AddClassic(char) end
	if TrailVariables.enabled then Trail_AddToCharacter(char) end
	if ForceFieldVariables.enabled then
		ForceField_Apply(char)
		ForceField_Watch(char)
	end
	if AuraTrailerVariables.enabled then AuraTrailer_Toggle(true) end
	Aura_RefreshParticle()
	Aura_RefreshClassic()
	CW_Reapply()
	AntiVoidState.lastSafePos = nil -- [v2 fix #06] fresh safe anchor per life
	task.delay(1.5, function()
		if ForceFieldVariables.enabled and player.Character == char then ForceField_Apply(char) end
	end)
end
