local function MusicInit()
	local HS = game:GetService("HttpService")
	local req = (syn and syn.request) or (http and http.request) or rawget(getgenv(), "http_request") or rawget(getgenv(), "request") or request
	local DIR = "SCPlayer"
	local CACHE, ART = DIR .. "/cache", DIR .. "/art"
	for _, f in ipairs({DIR, CACHE, ART}) do if isfolder and makefolder and not isfolder(f) then pcall(makefolder, f) end end
	local function rJSON(p) if not (isfile and readfile and isfile(p)) then return nil end local ok, d = pcall(function() return HS:JSONDecode(readfile(p)) end) return (ok and type(d) == "table") and d or nil end
	local function wJSON(p, d) if writefile then pcall(writefile, p, HS:JSONEncode(d)) end end
	local S = {token = "", volume = 80, boost = 100, speed = 1, pitch = 1, bass = 0, low = 0, mid = 0, high = 0, reverb = 0, comp = false, limit = 30, hud = false, hudScale = 100, vis = true, showSongs = true, showPlaylists = true, showArtists = true}
	local FAV, PLAY = {}, {}
	do
		local sv = rJSON(DIR .. "/settings.json")
		if sv then for k, v in pairs(S) do if sv[k] ~= nil and type(sv[k]) == type(v) then S[k] = sv[k] end end end
		if S.token == "" and isfile and isfile(DIR .. "/token.txt") then S.token = (readfile(DIR .. "/token.txt") or ""):gsub("%s", "") end
		local f = rJSON(DIR .. "/favorites.json") if type(f) == "table" then FAV = f end
		local p = rJSON(DIR .. "/playlists.json") if type(p) == "table" then PLAY = p end
	end
	local TOKENS = rJSON(DIR .. "/tokens.json") or {}
	local function saveS() wJSON(DIR .. "/settings.json", S) end
	local function saveF() wJSON(DIR .. "/favorites.json", FAV) end
	local function saveP() wJSON(DIR .. "/playlists.json", PLAY) end
	local function saveT() wJSON(DIR .. "/tokens.json", TOKENS) end
	local function enc(v) return (string.gsub(tostring(v), "[^%w%-%._~]", function(c) return string.format("%%%02X", string.byte(c)) end)) end
	local function fmtT(s) s = math.max(0, math.floor(s or 0)) return string.format("%d:%02d", math.floor(s / 60), s % 60) end
	local function headers() local h = {Accept = "application/json", ["User-Agent"] = "Mozilla/5.0"} if S.token ~= "" then h.Authorization = "OAuth " .. S.token end return h end
	local function httpGet(url, hd) if type(req) ~= "function" then return nil, 0, nil end local ok, r = pcall(req, {Url = url, Method = "GET", Headers = hd}) if not ok or type(r) ~= "table" then return nil, 0, nil end return r.Body, tonumber(r.StatusCode or r.Status or 0) or 0, r.Headers end
	local function scJSON(url) local b, c = httpGet(url, headers()) if type(b) ~= "string" or b == "" then return nil, c end local ok, d = pcall(function() return HS:JSONDecode(b) end) return (ok and d) or nil, c end
	local function pickStream(it) if type(it) ~= "table" or type(it.media) ~= "table" then return nil end for _, t in ipairs(it.media.transcodings or {}) do if type(t) == "table" and type(t.format) == "table" and t.format.protocol == "progressive" then return t.url end end return nil end
	local function mapTrack(it) return {id = tostring(it.id or math.random(1, 9e9)), title = it.title or "Unknown", artist = (type(it.user) == "table" and it.user.username) or "", userId = type(it.user) == "table" and it.user.id or nil, art = it.artwork_url or "", dur = (tonumber(it.duration) or 0) / 1000, stream = pickStream(it), permalink = it.permalink_url or ""} end
	local function searchTracks(q) local d, c = scJSON("https://api-v2.soundcloud.com/search/tracks?q=" .. enc(q) .. "&limit=" .. S.limit) if c == 401 or c == 403 then return nil, "token dead" end if type(d) ~= "table" or type(d.collection) ~= "table" then return nil, "search failed" end local out = {} for _, it in ipairs(d.collection) do local e = mapTrack(it) if e.stream then out[#out + 1] = e end end return out, nil end
	local function resolveLink(raw) local u = (tostring(raw or "")):match("^%s*(.-)%s*$") if u == "" then return nil, "paste a link" end if S.token == "" then return nil, "set token first" end local d, c = scJSON("https://api-v2.soundcloud.com/resolve?url=" .. enc(u)) if c == 401 or c == 403 then return nil, "token dead" end if type(d) ~= "table" then return nil, "resolve failed" end if type(d.media) == "table" then return {type = "tracks", tracks = {mapTrack(d)}}, d.title end if type(d.tracks) == "table" then local out = {} for _, it in ipairs(d.tracks) do local e = mapTrack(it) if e.stream then out[#out + 1] = e end end return {type = "album", name = d.title or "album", art = d.artwork_url or "", tracks = out}, nil end if d.kind == "user" then return {type = "user", id = d.id, name = d.username}, nil end return nil, "unsupported" end
	local function userContent(id) local tr, _ = scJSON("https://api-v2.soundcloud.com/users/" .. id .. "/tracks?limit=40") local al, _2 = scJSON("https://api-v2.soundcloud.com/users/" .. id .. "/playlists?limit=20") local tracks, albums = {}, {} if type(tr) == "table" then for _, it in ipairs(tr.collection or tr) do local e = mapTrack(it) if e.stream then tracks[#tracks + 1] = e end end end if type(al) == "table" then for _, it in ipairs(al.collection or al) do local out = {} for _, t in ipairs(it.tracks or {}) do local e = mapTrack(t) if e.stream then out[#out + 1] = e end end if #out > 0 then albums[#albums + 1] = {name = it.title, art = it.artwork_url or "", tracks = out} end end end return tracks, albums end
	local function handshake(e) if not e.stream then if e.permalink == "" then return nil end local d = scJSON("https://api-v2.soundcloud.com/resolve?url=" .. enc(e.permalink)) if type(d) == "table" and type(d.media) == "table" then e.stream = pickStream(d) end if not e.stream then return nil end end local h = scJSON(e.stream) if type(h) == "table" and type(h.url) == "string" then return h.url end return nil end
	local function cacheAudio(e) if e.asset then return e.asset end local url = handshake(e) if not url then return nil end local path = CACHE .. "/" .. e.id .. ".mp3" if isfile and isfile(path) then local ok, a = pcall(getcustomasset, path) if ok and a ~= "" then e.asset = a return a end end local body = httpGet(url, nil) if type(body) ~= "string" or #body < 4096 then return nil end if writefile then pcall(writefile, path, body) end local ok, a = pcall(getcustomasset, path) if ok and a ~= "" then e.asset = a return a end return nil end
	local function artUrl(e) local a = e.art or "" if a == "" or a:find("default_avatar") then return "" end return (string.gsub(a, "-large", "-t500x500")) end
	local function cacheArt(e) local url = artUrl(e) if url == "" or e.artAsset then return end local path = ART .. "/" .. e.id .. ".png" local got = nil if isfile and isfile(path) then local ok, a = pcall(getcustomasset, path) if ok and a ~= "" then got = a end end if not got then local body = httpGet(url, nil) if type(body) ~= "string" or #body < 256 then return end if writefile then pcall(writefile, path, body) end local ok, a = pcall(getcustomasset, path) if ok and a ~= "" then got = a end end if not got then local ok2, a2 = pcall(function() local b = httpGet((string.gsub(url, "-t500x500", "-large")), nil) if type(b) == "string" and #b > 256 then if writefile then pcall(writefile, path, b) end return getcustomasset(path) end end) if ok2 and a2 then got = a2 end end if got then e.artAsset = got for _, lb in ipairs(e._artLabels or {}) do if lb.Parent then lb.Image = got end end end end
	local function bindArt(lb, e) e._artLabels = e._artLabels or {} table.insert(e._artLabels, lb) lb.Image = e.artAsset or artUrl(e) if not e.artAsset and artUrl(e) ~= "" then task.spawn(cacheArt, e) end end

	local MTOP, MLEFT = 41, CONFIG.SIDEBAR_WIDTH + 1
	local musicFrame = new("Frame", {Position = UDim2.new(0, MLEFT, 0, MTOP), Size = UDim2.new(1, -MLEFT, 1, -MTOP), BackgroundTransparency = 1, Visible = false, ClipsDescendants = true, ZIndex = 5}, main)
	local sound = new("Sound", {Name = "SCP_Sound"}, musicFrame)
	local eqU = new("EqualizerSoundEffect", {}, sound)
	local eqB = new("EqualizerSoundEffect", {}, sound)
	local eqG = new("EqualizerSoundEffect", {}, sound)
	local pitchFx = new("PitchShiftSoundEffect", {}, sound)
	local echoFx = new("EchoSoundEffect", {}, sound)
	local compFx = new("CompressorSoundEffect", {}, sound)
	local function applyFx()
		eqU.LowGain = math.clamp(S.low, -80, 10); eqU.MidGain = math.clamp(S.mid, -80, 10); eqU.HighGain = math.clamp(S.high, -80, 10)
		eqB.LowGain = math.clamp(S.bass, 0, 10); eqB.MidGain = 0; eqB.HighGain = 0
		local gdb = math.max(0, 20 * math.log(S.boost / 100, 10))
		eqG.LowGain = math.min(10, gdb); eqG.MidGain = math.min(10, gdb); eqG.HighGain = math.min(10, gdb)
		pitchFx.Enabled = math.abs(S.pitch - 1) > 0.001; pitchFx.Octave = math.clamp(S.pitch, 0.5, 2)
		sound.PlaybackSpeed = math.clamp(S.speed, 0.5, 2)
		echoFx.Enabled = S.reverb > 0; echoFx.Delay = 0.24; echoFx.Feedback = math.clamp(S.reverb / 130, 0, 0.75); echoFx.DryLevel = 1; echoFx.WetLevel = math.clamp(S.reverb / 100, 0, 1)
		compFx.Enabled = S.comp
		sound.Volume = S.volume / 100
	end
	local queue, cur, repeatOne, status = {}, 0, false, ""
	local function favIdx(id) for i, e in ipairs(FAV) do if e.id == id then return i end end return nil end
	local function copyE(e) return {id = e.id, title = e.title, artist = e.artist, userId = e.userId, art = e.art, dur = e.dur, stream = e.stream, permalink = e.permalink} end
	local function playNow(e) table.insert(queue, math.min(cur + 1, #queue + 1), copyE(e)) loadIdx(cur + 1) end
	function loadIdx(i) local e = queue[i] if not e then return end cur = i sound:Stop() status = "loading" task.spawn(function() local a = cacheAudio(e) if queue[cur] ~= e then return end if not a then status = "stream failed" return end sound.SoundId = a sound.TimePosition = 0 sound:Play() status = "" end) end
	sound.Ended:Connect(function() if repeatOne then sound.TimePosition = 0 sound:Play() return end if cur < #queue then loadIdx(cur + 1) else sound:Stop() end end)

