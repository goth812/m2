		new("UICorner", {CornerRadius = UDim.new(0.5, 0)}, sknob)
		local value = m.def
		local function setVal(v, silent, smooth)
			v = math.clamp(v, m.min, m.max)
			value = v
			local ratio = (v - m.min) / (m.max - m.min)
			local fillSize = UDim2.new(ratio, 0, 1, 0)
			local knobPos = UDim2.new(ratio, -5, 0.5, -5)
			if smooth then
				tween(fill, 0.2, {Size = fillSize})
				tween(sknob, 0.2, {Position = knobPos})
			else
				fill.Size = fillSize
				sknob.Position = knobPos
			end
			if not valueBox:IsFocused() then valueBox.Text = fmt(v, m.round) end
			if not silent then cb(v) end
		end
		local function fromPos(p)
			local ap, asz = trackHit.AbsolutePosition, trackHit.AbsoluteSize
			local ratio = math.clamp((p.X - ap.X) / asz.X, 0, 1)
			setVal(m.min + ratio * (m.max - m.min))
		end
		trackHit.InputBegan:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
				fromPos(inp.Position)
