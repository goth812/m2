	if obj:IsA("TextButton") or obj:IsA("TextBox") or obj:IsA("ScrollingFrame") then
		table.insert(dragExcludes, obj)
	end
end

local function isExcluded(p)
	if not main.Visible then return false end
	for _, g in ipairs(dragExcludes) do
		if pointInGui(g, p) then return true end
	end
	return false
end

local function makeDraggable(target, onClick, useExcludes)
	target.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
		if useExcludes and isExcluded(input.Position) then return end
		local startPos = input.Position
		local origPos = target.Position
		local moved = false
		local cMove, cEnd
		cMove = UserInputService.InputChanged:Connect(function(inp)
			if inp ~= input then return end
			local d = inp.Position - startPos
			if d.Magnitude > CONFIG.DRAG_THRESHOLD then moved = true end
			target.Position = origPos + UDim2.fromOffset(d.X, d.Y)
		end)
		cEnd = UserInputService.InputEnded:Connect(function(inp)
			if inp ~= input then return end
			cMove:Disconnect()
			cEnd:Disconnect()
			if not moved and onClick then onClick() end
		end)
	end)
end

