	local hatGui = new("ScreenGui", {Name = randomString(8), ResetOnSpawn = false, IgnoreGuiInset = true}, getGuiParent())
local HN_SEG, HN_TAU, HN_MAXROWS = 48, math.pi * 2, 220
local HN = {
	rows = {}, shown = {}, cpos = {}, csize = {}, ccol = {},
	px = table.create(HN_SEG + 1), py = table.create(HN_SEG + 1),
	cos = table.create(HN_SEG), sin = table.create(HN_SEG),
	ord = table.create(HN_SEG + 1), stack = table.create(HN_SEG + 2),
	white = Color3.new(1, 1, 1), black = Color3.new(0, 0, 0),
	R = 1.55, H = 0.82, DROP = 0.02, ALPHA = 0.72,
}
for i = 1, HN_SEG do
	local a = (i - 1) / HN_SEG * HN_TAU
	HN.cos[i] = math.cos(a) * HN.R
	HN.sin[i] = math.sin(a) * HN.R
end
local function hnOrder(i, j)
	local ax, bx = HN.px[i], HN.px[j]
	return ax == bx and HN.py[i] < HN.py[j] or ax < bx
end
local function hnHull(n)
	local px, py, ord, st = HN.px, HN.py, HN.ord, HN.stack
	for i = 1, n do ord[i] = i end
	table.sort(ord, hnOrder)
	local m = 0
	for k = 1, n do
		local i = ord[k]; local x, y = px[i], py[i]
		while m >= 2 do
			local o, a = st[m - 1], st[m]
			if (px[a] - px[o]) * (y - py[o]) - (py[a] - py[o]) * (x - px[o]) > 0 then break end
			m = m - 1
		end
		m = m + 1; st[m] = i
	end
	local lower = m
	for k = n - 1, 1, -1 do
		local i = ord[k]; local x, y = px[i], py[i]
		while m > lower do
			local o, a = st[m - 1], st[m]
			if (px[a] - px[o]) * (y - py[o]) - (py[a] - py[o]) * (x - px[o]) > 0 then break end
			m = m - 1
		end
		m = m + 1; st[m] = i
	end
	return m - 1
end
hnVisible = function(state)
