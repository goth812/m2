				end)
			end
		end)
		valueBox.Focused:Connect(function() valueBox.TextColor3 = CONFIG.COLOR_TEXT_ACTIVE end)
		valueBox.FocusLost:Connect(function()
			valueBox.TextColor3 = CONFIG.COLOR_TEXT_DIM
			local n = tonumber(valueBox.Text)
			if n then setVal(n, false, true) else valueBox.Text = fmt(value, m.round) end
		end)
		setVal(m.def, true)
		cb(m.def)
	end

