local uiHidden = false
local animBusy = false

local function hideGui()
	if uiHidden or animBusy then return end
	uiHidden = true
	animBusy = true
	closePanel()
	tween(main, CONFIG.FADE_DURATION, {GroupTransparency = 1}).Completed:Connect(function()
		main.Visible = false
		square.Visible = true
		square.GroupTransparency = 1
		tween(square, CONFIG.FADE_DURATION, {GroupTransparency = 0}).Completed:Connect(function()
			animBusy = false
		end)
	end)
end

local function showGui()
	if not uiHidden or animBusy then return end
	uiHidden = false
	animBusy = true
	tween(square, CONFIG.FADE_DURATION, {GroupTransparency = 1}).Completed:Connect(function()
		square.Visible = false
		main.Visible = true
		main.GroupTransparency = 1
