local KickShield = {enabled = false, hooked = false}
local function KickShield_Set(v)
	KickShield.enabled = v
	if not v then
		pcall(function()
			if typeof(restorefunction) == "function" and KickShield.hooked then
				restorefunction(lp.Kick)
				KickShield.hooked = false
			end
		end)
		return
	end
	local function ksInstall()
		if Bypass.Present then
			print("[ALOHA] kick shield пропущен: Adonis рядом — вместо него работают спящие детекторы")
			return
		end
		if typeof(hookfunction) ~= "function" then
			print("[ALOHA] kick shield недоступен: executor без hookfunction")
			return
		end
		pcall(function()
			hookfunction(lp.Kick, newcclosure(function() return nil end))
			KickShield.hooked = true
		end)
		print("[ALOHA] kick shield активен — клиентские кики глушатся")
	end
	if Bypass.Present then
		print("[ALOHA] kick shield пропущен: Adonis рядом — вместо него работают спящие детекторы")
		return
	end
	if (os.clock() - Bypass.StartTime) < 8 then
		print("[ALOHA] kick shield: ожидание 8с (проверяем не подгрузится ли Adonis)...")
		task.delay(8, function()
			if KickShield.enabled then
				pcall(function() Bypass.Neutralized = Bypass.Neutralized + bypass_scan_full() end)
				bypass_refresh_present()
				ksInstall()
			end
		end)
		return
	end
	ksInstall()
end

local function AntiVoid_Toggle(v)
	AntiVoidState.enabled = v
	if not v then
		workspace.FallenPartsDestroyHeight = -50
		AntiVoidState.lastSafePos = nil
		AntiVoidState.armed = true
		if AntiVoidState.conn then AntiVoidState.conn:Disconnect() AntiVoidState.conn = nil end
		return
	end
	if AntiVoidState.mode == "Nokill" then
		workspace.FallenPartsDestroyHeight = -math.huge
	else
		if AntiVoidState.conn then AntiVoidState.conn:Disconnect() end
		AntiVoidState.conn = RunService.Heartbeat:Connect(function()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not (hrp and hum) then return end
			if hrp.Position.Y > AntiVoidState.minY then
				if hum:GetState() ~= Enum.HumanoidStateType.Freefall then
					AntiVoidState.lastSafePos = hrp.CFrame
				end
				AntiVoidState.armed = true
			elseif AntiVoidState.armed and AntiVoidState.lastSafePos then
				pcall(function()
					hrp.CFrame = AntiVoidState.lastSafePos + Vector3.new(0, 4, 0)
				end)
				AntiVoidState.armed = false
			end
		end)
	end
end
local function AntiVoid_SetMode(mode)
	local wasOn = AntiVoidState.enabled
	if wasOn then AntiVoid_Toggle(false) end
	AntiVoidState.mode = mode
	if wasOn then AntiVoid_Toggle(true) end
end

