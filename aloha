local function pointInGui(g, p)
	local ap, as = g.AbsolutePosition, g.AbsoluteSize
	return p.X >= ap.X and p.X <= ap.X + as.X and p.Y >= ap.Y and p.Y <= ap.Y + as.Y
end

local openPanel = nil
local function closePanel()
	if openPanel then
		local p = openPanel.frame
		openPanel = nil
		tween(p, 0.12, {Size = UDim2.fromOffset(p.Size.X.Offset, 0), GroupTransparency = 1}).Completed:Connect(function()
			p:Destroy()
		end)
	end
end
UserInputService.InputBegan:Connect(function(inp)
	if not openPanel then return end
	if inp.UserInputType ~= Enum.UserInputType.Touch and inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
	if pointInGui(openPanel.frame, inp.Position) or pointInGui(openPanel.anchor, inp.Position) then return end
	closePanel()
end)

local function openPanelFrame(w, h, anchor, radius)
	local vw, vh = Camera.ViewportSize.X, Camera.ViewportSize.Y
	local ax = anchor.AbsolutePosition.X
	local px = ax
	if px + w > vw - 4 then px = math.min(ax + anchor.AbsoluteSize.X - w, vw - w - 4) end
	px = math.max(4, px)
	local py = anchor.AbsolutePosition.Y + anchor.AbsoluteSize.Y + 2
	if py + h > vh - 4 then py = math.max(4, anchor.AbsolutePosition.Y - h - 2) end
	local panel = new("CanvasGroup", {
		Size = UDim2.fromOffset(anchor.AbsoluteSize.X, 0),
		Position = UDim2.fromOffset(px, py),
		BackgroundColor3 = CONFIG.COLOR_PANEL,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		GroupTransparency = 1,
	}, overlayLayer)
	new("UICorner", {CornerRadius = UDim.new(0, radius or 6)}, panel)
	tween(panel, 0.15, {Size = UDim2.fromOffset(w, h), GroupTransparency = 0})
	return panel
end

