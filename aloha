local function sortTiles()
	for pid = 1, PAGE_COUNT do
		local list = pageCards[pid] or {}
		table.sort(list, function(a, b) return a.name:lower() < b.name:lower() end)
		for i, co in ipairs(list) do
			local col = pages[pid].cols[((i - 1) % 2) + 1]
			co.col = col
			co.frame.Parent = col
			co.frame.LayoutOrder = math.ceil(i / 2)
		end
	end
end
