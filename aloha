		local fill = new("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = CONFIG.COLOR_ACCENT, BorderSizePixel = 0}, track)
		new("UICorner", {CornerRadius = UDim.new(0, 3)}, fill)
