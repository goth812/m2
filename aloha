local function applyParticleAuraToCharacter(character, auraName, color)
	local cached = loadedParticleAuras[auraName]
	if not cached then
		local id = particleAuraIdByName[auraName]
		if not id then return {} end
		local ok, result = pcall(function() return game:GetObjects(id)[1] end)
		if ok and result then
			loadedParticleAuras[auraName] = result
			cached = result
		end
	end
	if not cached then return {} end
	local localParts = {}
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("BasePart") then localParts[child.Name] = child end
	end
	local cloned = cached:Clone()
	local created = {}
	for _, part in ipairs(cloned:GetChildren()) do
		local targetPart = localParts[part.Name]
		if targetPart then
			for _, child in ipairs(part:GetChildren()) do
				pcall(function()
					local inst = child:Clone()
					inst.Name = "AlohaAuraParticle"
					inst.Parent = targetPart
					if color then tintParticleSubtree(inst, color) end
					table.insert(created, inst)
				end)
			end
		end
	end
	pcall(function() cloned:Destroy() end)
	for _, p in ipairs(created) do
		pcall(function()
			if p:IsA("ParticleEmitter") then p.Enabled = true end
		end)
		for _, d in ipairs(p:GetDescendants()) do
			pcall(function()
				if d:IsA("ParticleEmitter") then d.Enabled = true end
			end)
		end
	end
	return created
end
local function ParticleAura_DisableOne(auraName)
	if activeParticleAuras[auraName] then
		for _, p in ipairs(activeParticleAuras[auraName]) do
			if p then pcall(function() p:Destroy() end) end
		end
		activeParticleAuras[auraName] = nil
	end
end

local function applyAuraModifiers()
	local t = AuraState.transparency
	local sp = AuraState.speed
	local seq = NumberSequence.new(t)
	local function modObj(obj)
		pcall(function()
			if obj:IsA("ParticleEmitter") then
				obj.Transparency = seq
				obj.TimeScale = sp
			elseif obj:IsA("Beam") then
				obj.Transparency = seq
				obj.TextureSpeed = sp
			end
		end)
	end
	for _, list in pairs(activeParticleAuras) do
		for _, obj in ipairs(list) do
			if obj then
				modObj(obj)
				for _, d in ipairs(obj:GetDescendants()) do modObj(d) end
			end
		end
	end
	if activeSafe then
		for _, obj in ipairs(activeSafe:GetDescendants()) do modObj(obj) end
	end
end

local function Aura_RefreshParticle()
	local char = player.Character
	if not char then return end
	for _, auraName in ipairs(PARTICLE_LIST) do ParticleAura_DisableOne(auraName) end
	DisableSafe()
	if not AuraState.enabled then return end
	for auraName, isSel in pairs(AuraState.selected) do
		if isSel then
			task.spawn(function()
				if auraName == "Safe" then
					AttachAuraSafe(char, AuraState.color)
				else
					activeParticleAuras[auraName] = applyParticleAuraToCharacter(char, auraName, AuraState.color)
				end
				applyAuraModifiers()
			end)
		end
	end
end

