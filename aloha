local Bypass = { Active = false, Present = false, Neutralized = 0, Seen = {}, Tables = {}, StartTime = os.clock(), OnAdonisFound = function() end }
local function bypass_neutralize(fn)
	if Bypass.Seen[fn] then return false end
	Bypass.Seen[fn] = true
	pcall(function() hookfunction(fn, newcclosure(function() return false end)) end)
	return true
end
local DETECTOR_NAMES = { "indexInstance", "newindexInstance", "namecallInstance" }
local function bypass_neuter_decider(fn)
	if Bypass.Seen[fn] then return false end
	if typeof(getconstants) ~= "function" then return false end
	local ok, consts = pcall(getconstants, fn)
	if not ok or type(consts) ~= "table" then return false end
	for _, c in ipairs(consts) do
		if type(c) == "string" then
			for _, dn in ipairs(DETECTOR_NAMES) do
				if c == dn then return bypass_neutralize(fn) end
			end
		end
	end
	return false
end
local function bypass_is_action_stack(t)
	local a = t[1]
	return (a == "kick" or a == "log") and type(t[2]) == "function"
end
local function bypass_has_detector_key(t)
	for _, dn in ipairs(DETECTOR_NAMES) do
		if rawget(t, dn) ~= nil then return true end
	end
	return false
end
local function bypass_scan_table(t)
	local found = 0
	pcall(function()
		local function scan(tbl, depth)
			if depth > 3 then return end
			if bypass_is_action_stack(tbl) and type(tbl[2]) == "function" then
				if bypass_neutralize(tbl[2]) then found = found + 1 end
			end
			for _, v in pairs(tbl) do
				if type(v) == "table" then
					if bypass_is_action_stack(v) and type(v[2]) == "function" then
						if bypass_neutralize(v[2]) then found = found + 1 end
					end
					scan(v, depth + 1)
				elseif type(v) == "function" then
					if bypass_neuter_decider(v) then found = found + 1 end
				end
			end
		end
		scan(t, 0)
	end)
	return found
end
local function bypass_scan_full()
	local found = 0
	if typeof(getgc) ~= "function" or typeof(hookfunction) ~= "function" then return found end
	for _, obj in ipairs(getgc(true)) do
		if type(obj) == "table" then
			local hit = bypass_is_action_stack(obj) or bypass_has_detector_key(obj)
			if not hit then
				pcall(function()
					for _, v in pairs(obj) do
						if type(v) == "table" and (bypass_is_action_stack(v) or bypass_has_detector_key(v)) then
							hit = true
							return
						end
					end
				end)
			end
			if hit then
				Bypass.Tables[obj] = true
				found = found + bypass_scan_table(obj)
			end
		end
	end
	return found
end
local function bypass_adonis_hint()
	pcall(function()
		for _, v in ipairs(game:GetService("ReplicatedStorage"):GetChildren()) do
			local n = v.Name:lower()
			if n:find("adonis", 1, true) or n == "admin" or n:find("antiexploit", 1, true) then
				Bypass.Present = true
				return
			end
		end
	end)
end
local function bypass_refresh_present()
	Bypass.Present = next(Bypass.Tables) ~= nil
	if not Bypass.Present then bypass_adonis_hint() end
end
do
	pcall(function()
		Bypass.Neutralized = bypass_scan_full()
		bypass_refresh_present()
		task.delay(5, function()
			pcall(function()
				Bypass.Neutralized = Bypass.Neutralized + bypass_scan_full()
				bypass_refresh_present()
				if not Bypass.Present then
					task.delay(55, function() pcall(bypass_scan_full) end)
					return
				end
				task.spawn(function()
					local n = 0
					while task.wait(30) do
						n = n + 1
						pcall(function()
							for t in pairs(Bypass.Tables) do
								if type(t) == "table" then bypass_scan_table(t) end
							end
							if n % 4 == 0 then bypass_scan_full() end
						end)
						if Bypass.Present then pcall(Bypass.OnAdonisFound) end
					end
				end)
			end)
		end)
		Bypass.Active = true
	end)
end
