		local a = loadAsset("aloharecode/arrows/arrow" .. i .. ".png")
		arAssets[i] = (a ~= "") and a or "rbxassetid://4918373417"
	end
	local arGui = new("ScreenGui", {Name = randomString(9), ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5}, getGuiParent())
	local arPool, arState = {}, {}
	local function angDiff(a, b)
		local d = (a - b) % (math.pi * 2)
		if d > math.pi then d = d - math.pi * 2 end
		return d
	end
	local function arLabel(pl)
		local st = arState[pl]
		if st then return st end
		local lb = arPool[#arPool]
		if lb then table.remove(arPool) else
			lb = new("ImageLabel", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), ScaleType = Enum.ScaleType.Fit, Visible = false, ZIndex = 1}, arGui)
		end
		st = {label = lb, alpha = 0, target = 0, angle = 0, flip = 0, px = 0, py = 0}
		arState[pl] = st
		return st
	end
	RunService.RenderStepped:Connect(function(dt)
		if not AR.on then
			for _, st in pairs(arState) do st.label.Visible = false end
			return
		end
		local cam = Camera
		local vp = cam.ViewportSize
		local cx, cy = vp.X * 0.5, vp.Y * 0.5
		local radius = (AR.radiusPct / 100) * (math.min(vp.X, vp.Y) * 0.5)
		local seen = {}
		for _, pl in ipairs(Players:GetPlayers()) do
			local st = arLabel(pl)
			seen[pl] = true
			local ch = pl.Character
			local root = ch and ch:FindFirstChild("HumanoidRootPart")
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local alive = root and hum and hum.Health > 0
			if not alive or pl == player then
				st.target = 0
			else
				local p = cam:WorldToViewportPoint(root.Position)
				local onScr = p.Z > 0 and p.X >= 0 and p.X <= vp.X and p.Y >= 0 and p.Y <= vp.Y
				if onScr then
					st.target = 0
				elseif math.abs(p.Z) < 0.05 then
					st.target = st.alpha > 0.02 and 1 or 0
				else
					local dx, dy
					if p.Z > 0 then dx, dy = p.X - cx, p.Y - cy else dx, dy = cx - p.X, cy - p.Y end
					local mag = math.sqrt(dx * dx + dy * dy)
					if mag < 1 then st.target = 0 else
						local na = math.atan2(dy, dx)
						if st.alpha > 0.05 then
							local d = angDiff(na, st.angle)
							if math.abs(d) > 2 then
								st.flip = st.flip + 1
								if st.flip >= 3 then st.angle = na st.flip = 0 end
							else st.angle = na st.flip = 0 end
						else st.angle = na st.flip = 0 end
						st.target = 1
					end
				end
			end
			local fin = math.max(0.04, AR.fade)
			local delta = math.clamp(st.target - st.alpha, -dt / fin, dt / fin)
			st.alpha = math.clamp(st.alpha + delta, 0, 1)
			local lb = st.label
			if st.alpha <= 0.02 then lb.Visible = false else
				if st.target > 0 then
					st.px = cx + math.cos(st.angle) * radius
					st.py = cy + math.sin(st.angle) * radius
				end
				lb.Visible = true
				lb.Image = arAssets[AR.skin]
				lb.ImageColor3 = AR.color
				lb.ImageTransparency = 1 - st.alpha
				lb.Size = UDim2.fromOffset(AR.size, AR.size)
				lb.Position = UDim2.fromOffset(st.px, st.py)
				lb.Rotation = math.deg(st.angle) + 90
			end
		end
		for pl in pairs(arState) do
			if not seen[pl] then
				arState[pl].label.Visible = false
				table.insert(arPool, arState[pl].label)
