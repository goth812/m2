HatNew_Update = function()
	if not DrawingAvailable then return end
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then hnVisible(false) return end
	local cam = Camera
	local hp = head.Position
	local baseY = hp.Y + head.Size.Y * 0.5 - HN.DROP
	local center = Vector3.new(hp.X, baseY, hp.Z)
	local apex = cam:WorldToViewportPoint(center + Vector3.new(0, HN.H, 0))
	if apex.Z <= 0 then hnVisible(false) return end
	local probe = cam:WorldToViewportPoint(center + Vector3.new(HN.cos[1], 0, HN.sin[1]))
	if probe.Z <= 0 then hnVisible(false) return end
	local px, py, cosT, sinT = HN.px, HN.py, HN.cos, HN.sin
	px[1], py[1] = apex.X, apex.Y
	px[2], py[2] = probe.X, probe.Y
	local cf = cam.CFrame
	local rv, uv, lv = cf.RightVector, cf.UpVector, cf.LookVector
	local ox, oy, oz = center.X - cf.Position.X, center.Y - cf.Position.Y, center.Z - cf.Position.Z
	local bR = ox * rv.X + oy * rv.Y + oz * rv.Z
	local bU = ox * uv.X + oy * uv.Y + oz * uv.Z
	local bD = ox * lv.X + oy * lv.Y + oz * lv.Z
	local rvx, rvz, uvx, uvz, lvx, lvz = rv.X, rv.Z, uv.X, uv.Z, lv.X, lv.Z
	local view = cam.ViewportSize
	local scale = view.Y * 0.5 / math.tan(math.rad(cam.FieldOfView * 0.5))
	local midX, midY = view.X * 0.5, view.Y * 0.5
	local exact = false
	local dep = bD + HN.H * lv.Y
	if dep > 0 then
		local inv = scale / dep
		if math.abs(midX + (bR + HN.H * rv.Y) * inv - apex.X) <= 0.75 and math.abs(midY - (bU + HN.H * uv.Y) * inv - apex.Y) <= 0.75 then
			local c, s = cosT[1], sinT[1]
			dep = bD + c * lvx + s * lvz
			if dep > 0 then
				inv = scale / dep
				if math.abs(midX + (bR + c * rvx + s * rvz) * inv - probe.X) <= 0.75 and math.abs(midY - (bU + c * uvx + s * uvz) * inv - probe.Y) <= 0.75 then exact = true end
			end
		end
	end
	if exact then
		for i = 2, HN_SEG do
			local c, s = cosT[i], sinT[i]
			local d = bD + c * lvx + s * lvz
			if d <= 0 then hnVisible(false) return end
			local inv = scale / d
			px[i + 1] = midX + (bR + c * rvx + s * rvz) * inv
			py[i + 1] = midY - (bU + c * uvx + s * uvz) * inv
		end
	else
		for i = 2, HN_SEG do
			local p = cam:WorldToViewportPoint(center + Vector3.new(cosT[i], 0, sinT[i]))
			if p.Z <= 0 then hnVisible(false) return end
			px[i + 1], py[i + 1] = p.X, p.Y
		end
	end
	local hn = hnHull(HN_SEG + 1)
	if hn < 3 then hnVisible(false) return end
	local st = HN.stack
	local minY, maxY = math.huge, -math.huge
	for i = 1, hn do
		local y = py[st[i]]
		if y < minY then minY = y end
		if y > maxY then maxY = y end
	end
	local firstY = math.max(0, math.floor(minY))
	local lastY = math.min(view.Y, math.ceil(maxY))
	if lastY - firstY < 2 then hnVisible(false) return end
	local step = math.max(1, math.ceil((lastY - firstY) / HN_MAXROWS))
	local span = math.max(1, maxY - minY)
	local baseCol = HatVariables.color
	if HatVariables.rainbow then baseCol = Color3.fromHSV(tick() % HatVariables.rainbowSpeed / HatVariables.rainbowSpeed, 1, 1) end
	local used = 0
	for y0 = firstY, lastY - 1, step do
		local height = math.min(step, lastY - y0)
		local y = y0 + height * 0.5
		local left, right = math.huge, -math.huge
		local ax, ay = px[st[hn]], py[st[hn]]
		for i = 1, hn do
			local ix = st[i]; local bx, by = px[ix], py[ix]
			if (ay <= y and by > y) or (by <= y and ay > y) then
				local x = ax + (y - ay) * (bx - ax) / (by - ay)
				if x < left then left = x end
				if x > right then right = x end
			end
			ax, ay = bx, by
		end
		local width = right - left
		if width >= 2.5 then
			used = used + 1
			local row = hnRowF(used)
			local t = (y - minY) / span
			local col = baseCol
			if HatVariables.colorMode == "gradient" then col = HatVariables.color:Lerp(HatVariables.colorB, t) end
			local light = math.max(0, 1 - t * 1.35)
			local dark = math.max(0, (t - 0.58) / 0.42)
			col = col:Lerp(HN.white, light * 0.26):Lerp(HN.black, dark * 0.1)
			local pos = UDim2.fromOffset(left, y0)
			local size = UDim2.fromOffset(width, height)
			if tostring(HN.cpos[used]) ~= tostring(pos) then row.Position = pos HN.cpos[used] = pos end
			if tostring(HN.csize[used]) ~= tostring(size) then row.Size = size HN.csize[used] = size end
			if tostring(HN.ccol[used]) ~= tostring(col) then row.BackgroundColor3 = col HN.ccol[used] = col end
			if not HN.shown[used] then row.Visible = true HN.shown[used] = true end
		end
	end
	for i = used + 1, #HN.rows do
		if HN.shown[i] then HN.rows[i].Visible = false HN.shown[i] = false end
	end
end
