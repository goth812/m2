	local function buildModule(m, indent, parentEntry)
		local wrap = newRowInternal(m, indent)
		local entry = rows[#rows]
		entry.parent = parentEntry
		if m.type == "slider" then
			buildSlider(m, wrap, indent)
		elseif m.type == "toggle" then
			buildToggle(m, wrap, indent)
		elseif m.type == "dropdown" then
			buildDropdown(m, wrap, indent)
		elseif m.type == "multi" then
			buildMulti(m, wrap, indent)
		elseif m.type == "color" then
			buildColor(m, wrap, indent)
		end
		if m.settings then
			for _, sm in ipairs(m.settings) do
				buildModule(sm, true, entry)
			end
		end
	end

	refreshLayout = function()
		local y = 6
		local first = true
		for _, r in ipairs(rows) do
			local vis = true
			if r.parent then
				vis = r.parent.subOpen and r.parent.visible
			end
			if vis and r.m.dep then
				local dv = dropdownState[r.m.dep.name]
				if r.m.dep.values then
					vis = table.find(r.m.dep.values, dv) ~= nil
				else
					vis = (dv == r.m.dep.value)
				end
			end
			r.visible = vis
			r.wrap.Visible = vis
			if vis then
				if not first then y = y + 8 end
				r.wrap.Position = UDim2.new(0, r.indent and 10 or 0, 0, y)
				y = y + r.h
				first = false
			end
		end
		cardModulesHeight = first and 0 or (y + 8)
		if expanded then
			tween(card, 0.2, {Size = UDim2.new(1, 0, 0, CONFIG.TILE_HEIGHT + cardModulesHeight)})
		end
	end

	if hasModules then
		for _, m in ipairs(modules) do
			buildModule(m, false, nil)
		end
		refreshLayout()
		local eBusy = false
		expandBtn.Activated:Connect(function()
			if eBusy then return end
			eBusy = true
			expanded = not expanded
			if not expanded then closePanel() end
			tween(card, 0.2, {Size = UDim2.new(1, 0, 0, expanded and CONFIG.TILE_HEIGHT + cardModulesHeight or CONFIG.TILE_HEIGHT)})
			tween(expDown, 0.15, {ImageTransparency = expanded and 1 or 0})
			tween(expUp, 0.15, {ImageTransparency = expanded and 0 or 1})
			task.delay(0.2, function() eBusy = false end)
		end)
	end

	local enabled = false
	local function setState(v, silent)
		enabled = v
		cardEnabled = v
		card.BackgroundColor3 = v and CONFIG.COLOR_TILE_ON or CONFIG.COLOR_TILE
		nameLabel.TextColor3 = v and CONFIG.COLOR_TEXT_ACTIVE or CONFIG.COLOR_TEXT_DIM
		sw.BackgroundColor3 = v and CONFIG.COLOR_ACCENT or CONFIG.COLOR_TRACK_OFF
		local knobPos = v and UDim2.new(0, CONFIG.SWITCH_W - 18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
		if silent then
			knob.Position = knobPos
		else
			tween(knob, 0.15, {Position = knobPos})
		end
		if v then
			for _, entry in ipairs(moduleStore) do
				if entry.args and entry.m.cb then
					entry.m.cb(unpack(entry.args))
				end
			end
		end
		if callback and not silent then callback(v) end
	end

	topBtn.Activated:Connect(function()
		setState(not enabled)
	end)
	setState(default, true)

	table.insert(settingsRegistry, {name = name:lower(), frame = card, page = pageId})
	if not pageCards[pageId] then pageCards[pageId] = {} end
	local cardObj = {SetState = setState, GetState = function() return enabled end, Page = pageId, frame = card, name = name, col = target}
	table.insert(pageCards[pageId], cardObj)
	return cardObj
end

local function applyFilter(text)
	text = text:lower()
	for _, e in ipairs(settingsRegistry) do
		e.frame.Visible = (text == "" or e.name:find(text, 1, true) ~= nil)
	end
end
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	applyFilter(searchBox.Text)
end)

local staggerHandles = {}
local function staggerPage(pageId, dir)
	for _, h in ipairs(staggerHandles) do h:Cancel() end
	staggerHandles = {}
	local cards = pageCards[pageId] or {}
	for _, co in ipairs(cards) do
		co.frame.GroupTransparency = 1
	end
	for _, co in ipairs(cards) do
		local tw = TweenService:Create(co.frame, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0})
		tw:Play()
		table.insert(staggerHandles, tw)
	end
	for _, page in ipairs(pages) do
		for _, col in ipairs(page.cols) do
			if col.Visible then
				local baseX = col.Position.X
				col.Position = UDim2.new(baseX.Scale, baseX.Offset, 0, contentTop + dir * 20)
				tween(col, 0.2, {Position = UDim2.new(baseX.Scale, baseX.Offset, 0, contentTop)})
			end
		end
	end
end

local prevPageId = 1
selectPage = function(id)
	local dir = (id > prevPageId) and -1 or 1
	prevPageId = id
	activeId = id
	closePanel()
	for idx, page in ipairs(pages) do
		for _, col in ipairs(page.cols) do
			col.Visible = (idx == id)
		end
	end
	for _, it in ipairs(items) do
		local active = (it.id == id)
		it.lbl.TextColor3 = active and CONFIG.COLOR_TEXT_ACTIVE or CONFIG.COLOR_TEXT_DIM
		if it.icon then
			it.icon.ImageColor3 = active and CONFIG.COLOR_TEXT_ACTIVE or CONFIG.COLOR_TEXT_DIM
		end
	end
	repositionIndicator(true)
	applyFilter(searchBox.Text)
	staggerPage(id, dir)
end

for _, it in ipairs(items) do
	it.btn.Activated:Connect(function()
		selectPage(it.id)
	end)
end

