			local knobH = new("Frame", {Size = UDim2.new(1, 4, 0, 3), Position = UDim2.new(0, -2, 0, h * 118 - 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, hue)
