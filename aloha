local function SpeedSpoof_Set(on)
	if on == SpeedSpoof.active then return end
	SpeedSpoof.active = on
	if on then
		if Bypass.Present then
			print("[ALOHA] position spoof пропущен: Adonis — вместо него кламп под порог")
			return
		end
		if (os.clock() - Bypass.StartTime) < 8 then
			print("[ALOHA] spoof подождёт: подтверждаем что Adonis не подгрузится")
			return
		end
		if SpeedSpoof.hooked then return end
		if typeof(hookmetamethod) ~= "function" or typeof(getrawmetatable) ~= "function" then return end
		pcall(function()
			local mt = getrawmetatable(game)
			setreadonly(mt, false)
			local old = mt.__index
			SpeedSpoof.oldIndex = old
			mt.__index = newcclosure(function(self, key)
				if not checkcaller() and key == "Position" and typeof(self) == "Instance" then
					local ok, isPart = pcall(function() return self:IsA("BasePart") end)
					if ok and isPart then
						local char = player.Character
						if char and self == char:FindFirstChild("HumanoidRootPart") and SpeedSpoof.fakePos then
							return SpeedSpoof.fakePos
						end
					end
				end
				return old(self, key)
			end)
			setreadonly(mt, true)
			SpeedSpoof.hooked = true
			Bypass.OnAdonisFound = function() SpeedSpoof_Set(false) end
		end)
	else
		SpeedSpoof.fakePos = nil
		if SpeedSpoof.hooked then
			pcall(function()
				local mt = getrawmetatable(game)
				setreadonly(mt, false)
				mt.__index = SpeedSpoof.oldIndex
				setreadonly(mt, true)
				SpeedSpoof.hooked = false
			end)
		end
	end
end
